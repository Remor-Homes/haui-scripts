[Unit]
Description=Clear Chromium locks on boot (prevents stuck restore session)
After=network.target graphical.target
Before=chromium.service   # If you have a chromium kiosk service

[Service]
Type=oneshot
ExecStart=/home/haui/fpos_mqtt_ha/chromium_hostname_reset.sh
User=root
RemainAfterExit=yes

# Optional: Add some delay if Chromium starts too early
# ExecStartPre=/bin/sleep 3

[Install]
WantedBy=multi-user.target graphical.target